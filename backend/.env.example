# ==============================================================================
# SECURE FILE STORAGE USING CRYPTOGRAPHY - CRYPTO6 MSD
# Environment Configuration Template (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/secure_file_storage_crypto6

# Authentication & JWT Configuration
# Note: Use a strong random secret in production (minimum 32 characters)
JWT_SECRET=super_secret_jwt_crypto6_msd_key_must_be_very_long_and_secure_2026
JWT_EXPIRES_IN=7d

# Cryptography - Master Key (Key Encryption Key - KEK)
# Must be a cryptographically secure 256-bit key represented as a 64-character hexadecimal string
# Can be generated using Node.js: require('crypto').randomBytes(32).toString('hex')
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage Configuration
STORAGE_PATH=./storage/encrypted
MAX_FILE_SIZE_BYTES=52428800 # 50 Megabytes in bytes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window
