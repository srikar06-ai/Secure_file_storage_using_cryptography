    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "mongoose": "^8.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "vitest": "^2.1.8"
  }
}
