{
  "name": "secure-file-db",
  "version": "1.0.0",
  "description": "Secure Database Layer with MongoDB Replica Set, Mongoose, and Transactions for CRYPTO6 MSD",
  "type": "module",
  "main": "src/services/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:replica": "node scripts/verify-replica.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb"
  },
  "keywords": [
